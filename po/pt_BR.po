msgid "Provider API (via CLI)"
msgstr "API do provedor (via CLI)"

#: prefs.js:122
msgid "General"
msgstr "Geral"

#: prefs.js:148
msgid "Developer & Testing Options"
msgstr "Opções de desenvolvimento e teste"

#: prefs.js:150
msgid "Simulate custom CLI outputs and view debug logs."
msgstr "Simule saídas da CLI e veja logs de depuração."

#: prefs.js:155
msgid "Test with Custom CLI Output"
msgstr "Testar com saída personalizada da CLI"

#: prefs.js:157
msgid ""
"Simulate Codexbar-CLI outputs to test providers or other things and see how "
"the extension renders the data"
msgstr ""
"Simule saídas da codexbar-cli para testar provedores e ver como a extensão "
"exibe os dados"

#: prefs.js:170
msgid "Simulated Provider Name"
msgstr "Nome do provedor simulado"

#: prefs.js:182
msgid "Codexbar-CLI custom output"
msgstr "Saída personalizada da codexbar-cli"

#: prefs.js:183
msgid "Paste the raw JSON output to test"
msgstr "Cole a saída JSON bruta para testar"

#: prefs.js:233
msgid "Contribute & Contact"
msgstr "Contribuir e contato"

#: prefs.js:235
msgid ""
"Enjoy the community of Codexbar contributors and other Inled projects. We "
"are waiting for you!"
msgstr ""
"Participe da comunidade de colaboradores do CodexBar e de outros projetos da "
"Inled. Estamos esperando você!"

#: prefs.js:240
msgid "Add a New Provider"
msgstr "Adicionar um novo provedor"

#: prefs.js:242
msgid "Help the community by submitting a Pull Request on GitHub"
msgstr "Ajude a comunidade enviando um Pull Request no GitHub"

#: prefs.js:262
msgid "Leave a Review"
msgstr "Deixe uma avaliação"

#: prefs.js:264
msgid "Rate the extension on EGO or share on social media."
msgstr "Avalie a extensão no EGO ou compartilhe nas redes sociais."

#: prefs.js:284
msgid "Contact Inled"
msgstr "Fale com a Inled"

#: prefs.js:285
msgid "Questions? Suggestions? Write to us at hi@inled.es"
msgstr "Dúvidas? Sugestões? Escreva para hi@inled.es"

#: prefs.js:303
msgid "Visit inled.es"
msgstr "Visite inled.es"

#: prefs.js:305
msgid "Discover more tools and projects that might interest you!"
msgstr "Conheça outras ferramentas e projetos que podem interessar você!"

#: prefs.js:322
msgid "Join the Community"
msgstr "Entre na comunidade"

#: prefs.js:323
msgid "¡We have new Discord and Matrix channels!"
msgstr "Temos novos canais no Discord e no Matrix!"

#: prefs.js:402
msgid "Settings"
msgstr "Configurações"

#: prefs.js:406
msgid "Refresh Interval (minutes)"
msgstr "Intervalo de atualização (minutos)"

#: prefs.js:423
msgid "Display Mode"
msgstr "Modo de exibição"

#: prefs.js:425
msgid "Used"
msgstr "Usado"

#: prefs.js:425
msgid "Remaining"
msgstr "Restante"

#: prefs.js:438
msgid "Language"
msgstr "Idioma"

#: prefs.js:455
msgid "Show Provider Logos"
msgstr "Mostrar logos dos provedores"

#: prefs.js:457
msgid "Display the logo of each AI provider in the selection tabs"
msgstr "Mostra o logo de cada provedor nas abas"

#: prefs.js:470
msgid "Show Usage Pacing"
msgstr "Mostrar ritmo de uso"

#: prefs.js:472
msgid ""
"Display weekly pacing estimates (reserve or over pace) for large windows"
msgstr ""
"Mostra a estimativa de ritmo semanal (folga ou acima do ritmo) nas janelas "
"longas"

#: prefs.js:485
msgid "Show Provider Details"
msgstr "Mostrar detalhes do provedor"

#: prefs.js:487
msgid ""
"Display the extra detail sections reported by the provider CLI (credits, "
"spend history, rate limits)"
msgstr ""
"Mostra as seções extras informadas pela CLI do provedor (créditos, histórico "
"de gastos, limites)"

#: prefs.js:508
msgid "Top Bar & Appearance"
msgstr "Barra superior e aparência"

#: prefs.js:520
msgid "Show Numbers Only on Hover"
msgstr "Mostrar números só ao passar o mouse"

#: prefs.js:521
msgid ""
"Keep only the provider logos in the top bar; usage appears while the pointer "
"is over them"
msgstr ""
"Deixa só os logos na barra superior; o uso aparece enquanto o mouse estiver "
"em cima"

#: prefs.js:525
msgid "Hide After (seconds)"
msgstr "Esconder depois de (segundos)"

#: prefs.js:526
msgid "How long the numbers stay after the pointer leaves"
msgstr "Quanto tempo os números ficam depois que o mouse sai"

#: prefs.js:550
msgid "Compact Top Bar Text"
msgstr "Texto compacto na barra superior"

#: prefs.js:551
msgid "Smaller, lighter text and logos in the top bar"
msgstr "Texto e logos menores e mais leves na barra superior"

#: prefs.js:555
msgid "Use System Accent Color"
msgstr "Usar a cor de destaque do sistema"

#: prefs.js:556
msgid ""
"Color the usage bars with the accent color chosen in Settings › Appearance"
msgstr ""
"Pinta as barras de uso com a cor de destaque escolhida em Configurações › "
"Aparência"

#: prefs.js:560
msgid "Warning Colors"
msgstr "Cores de alerta"

#: prefs.js:561
msgid "Turn the bars yellow, orange and red as usage approaches the limit"
msgstr ""
"Deixa as barras amarelas, laranja e vermelhas conforme o uso se aproxima do "
"limite"

#: prefs.js:565
msgid "Animations"
msgstr "Animações"

#: prefs.js:566
msgid "Animate the top bar numbers, usage bars and tab changes"
msgstr "Anima os números da barra superior, as barras de uso e a troca de abas"

#: prefs.js:578
msgid "AI Providers"
msgstr "Provedores de IA"

#: prefs.js:580
msgid ""
"Enable providers and pick how each one connects. Direct API uses session "
"cookies from your keyring; the other choices run codexbar-cli with that --"
"source. Antigravity also needs the plugin."
msgstr ""
"Ative os provedores e escolha como cada um se conecta. A API direta usa "
"cookies de sessão do chaveiro; as outras opções rodam a codexbar-cli com "
"esse --source. O Antigravity também precisa do plugin."

#: prefs.js:650 prefs.js:688
msgid "Enabled"
msgstr "Ativado"

#: prefs.js:650 prefs.js:688
msgid "Disabled"
msgstr "Desativado"

#: prefs.js:705
msgid "Show in panel"
msgstr "Mostrar no painel"

#: prefs.js:707
msgid "Show this provider's usage windows as text in the top bar"
msgstr "Mostra as janelas de uso deste provedor como texto na barra superior"

#: prefs.js:736
msgid "Connection:"
msgstr "Conexão:"

#: prefs.js:770
msgid "Authentication Cookie (starts with __Secure...)"
msgstr "Cookie de autenticação (começa com __Secure...)"

#: prefs.js:784
msgid "Auto-Login from Browser"
msgstr "Login automático pelo navegador"

#: prefs.js:787
msgid ""
"Uses a local Python script to extract cookies from Chrome/Brave for this "
"provider."
msgstr ""
"Usa um script Python local para extrair os cookies deste provedor do Chrome/"
"Brave."

#: prefs.js:810
msgid "Session Cookies:"
msgstr "Cookies de sessão:"

#: prefs.js:819
msgid "Manual entry: Paste your session cookies here."
msgstr "Entrada manual: cole aqui os cookies de sessão."

#: prefs.js:832
msgid "CLI Command (e.g. codexbar --provider ...)"
msgstr "Comando da CLI (ex.: codexbar --provider ...)"

#: prefs.js:840
msgid "CLI Command:"
msgstr "Comando da CLI:"

#: prefs.js:845
msgid "Reset Default"
msgstr "Restaurar padrão"

#: prefs.js:889
msgid ""
"💡 Antigravity requires a trusted local SSL certificate to work. So we have "
"made a python script to help you do this in a single command:\n"
"\n"
"pip install codexbar-ssl-helper && codexbar-ssl-helper"
msgstr ""
"💡 O Antigravity precisa de um certificado SSL local confiável. Fizemos um "
"script Python que faz isso com um único comando:\n"
"\n"
"pip install codexbar-ssl-helper && codexbar-ssl-helper"

#: prefs.js:909
msgid "Remove Provider"
msgstr "Remover provedor"

#: prefs.js:960
msgid "Add Custom Provider"
msgstr "Adicionar provedor personalizado"

#: prefs.js:961
msgid "The extension should parse it correctly."
msgstr "A extensão deve interpretar corretamente."

#: prefs.js:972
msgid "New Provider"
msgstr "Novo provedor"

#: prefs.js:973
msgid "Enter the details for your custom AI provider."
msgstr "Informe os dados do seu provedor de IA personalizado."

#: prefs.js:984
msgid "Provider Name (e.g. MyLocalModel)"
msgstr "Nome do provedor (ex.: MeuModeloLocal)"

#: prefs.js:989
msgid "Command (e.g. codexbar --provider ...)"
msgstr "Comando (ex.: codexbar --provider ...)"

#: prefs.js:994
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:995
msgid "Add"
msgstr "Adicionar"

#: prefs.js:1041
msgid "Maintenance"
msgstr "Manutenção"

#: prefs.js:1045
msgid "Show Welcome Screen"
msgstr "Mostrar tela de boas-vindas"

#: prefs.js:1046
msgid "Reset first-run state"
msgstr "Voltar ao estado de primeira execução"

#: prefs.js:1081 prefs.js:1095
msgid "OK"
msgstr "OK"

#: prefs.js:1088
msgid "Cookie Importer Missing"
msgstr "Importador de cookies ausente"

#: prefs.js:1090
msgid ""
"To import cookies automatically from your browser, please install the python "
"dependency by running:\n"
"\n"
"pip install codexbar-cookie-importer"
msgstr ""
"Para importar cookies automaticamente do navegador, instale a dependência "
"Python com:\n"
"\n"
"pip install codexbar-cookie-importer"

#: prefs.js:1139
msgid "Timeout"
msgstr "Tempo esgotado"

#: prefs.js:1141
msgid ""
"The cookie importer is taking too long. Please ensure your browser is closed "
"and try again."
msgstr ""
"O importador de cookies está demorando demais. Feche o navegador e tente de "
"novo."

#: prefs.js:1175
msgid "Import Failed"
msgstr "Falha na importação"

#: prefs.js:1181
msgid "Cookies imported successfully!"
msgstr "Cookies importados com sucesso!"

#: prefs.js:1187
msgid "The importer returned no data."
msgstr "O importador não retornou dados."

#: prefs.js:1191
msgid "Error"
msgstr "Erro"

#: prefs.js:1201
msgid "Unexpected Error"
msgstr "Erro inesperado"

